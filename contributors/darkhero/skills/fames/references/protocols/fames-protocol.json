{
  "schema": 1,
  "id": "FAMES",
  "version": "1.1.0",
  "updated": "2026-08-10",
  "full_en": "First-principles Adaptive Minimal-token Evidence-aligned Self-consistency",
  "purpose": "Fleet-wide umbrella and standalone trigger for the complete FP, MTM, SCF, AEX, and SEAL contract.",
  "legacy_umbrella_aliases": [
    "AEX Stack"
  ],
  "narrow_terms": {
    "AEX": "Cross-cycle adaptation only; AEX remains the narrow evolution loop.",
    "AEX Loop": "The concrete EXEC-INSTR-DISTILL-PROMOTE-OPEN-GUARD evolution cycle."
  },
  "letters": {
    "F": {
      "concept": "FP",
      "meaning": "First-principles"
    },
    "A": {
      "concept": "AEX",
      "meaning": "Adaptive evolution"
    },
    "M": {
      "concept": "MTM",
      "meaning": "Minimal-token mechanism"
    },
    "E": {
      "concept": "SEAL",
      "meaning": "Evidence-aligned completion"
    },
    "S": {
      "concept": "SCF",
      "meaning": "Self-consistent residual"
    }
  },
  "execution_order": [
    "FP",
    "MTM",
    "SCF",
    "AEX",
    "SEAL"
  ],
  "canonical_protocols": {
    "FP": "_registry/goal-vector-protocol.json",
    "MTM": "_registry/mtm-protocol.json",
    "SCF": "_registry/scf-protocol.json",
    "AEX": "_registry/fleet-token-ladder.json",
    "SEAL": "_registry/seal-protocol.json"
  },
  "trigger": {
    "tokens": [
      "FAMES",
      "$fames"
    ],
    "standalone_means": "Execute and account for the complete five-phase contract.",
    "does_not_expand_authority": true,
    "required_phase_states": [
      "PASS",
      "NOT_APPLICABLE",
      "UNKNOWN",
      "FAIL"
    ],
    "not_applicable_rule": "Allowed only when the phase activation predicate is demonstrably false; cite the evidence.",
    "unknown_rule": "Missing, stale, mismatched, exceptional, or unverifiable evidence is UNKNOWN and fails closed."
  },
  "phase_contract": {
    "FP": {
      "owns": [
        "Outcome",
        "Verification",
        "Constraints",
        "semantic_goal_hash"
      ],
      "must_not_own": [
        "execution_loop"
      ]
    },
    "MTM": {
      "owns": [
        "bounded_route",
        "read_budget",
        "receipt_reuse"
      ],
      "must_not_own": [
        "completion_truth"
      ]
    },
    "SCF": {
      "activation": "A verified result exists for the current goal identity.",
      "owns": [
        "goal_result_residual"
      ],
      "must_not_own": [
        "evidence_collection"
      ]
    },
    "AEX": {
      "activation": "A verified comparable cross-cycle residual remains.",
      "owns": [
        "cross_cycle_adaptation"
      ],
      "must_not_own": [
        "one_shot_execution"
      ]
    },
    "SEAL": {
      "owns": [
        "completion_predicate",
        "evidence_freshness",
        "identity_alignment",
        "graph_closure"
      ],
      "must_not_own": [
        "another_evolution_loop"
      ]
    }
  },
  "completion_predicate": {
    "goal_hash_matches": true,
    "required_evidence_is_fresh_and_passing": true,
    "active_work_graph_is_closed": true,
    "all_phase_states_are_terminal": true,
    "accepted_terminal_states": [
      "PASS",
      "NOT_APPLICABLE"
    ]
  },
  "canonical_skill": "fames",
  "validator": "_skill/engines/validate-fames-stack.py",
  "distribution": {
    "mode": "content-addressed-github-bundle",
    "canonical_package": "_skill/fleet-skills/fames",
    "bundle_manifest": "_skill/fleet-skills/fames/bundle-manifest.json",
    "bundled_protocol": "_skill/fleet-skills/fames/references/protocols/fames-protocol.json",
    "package_verifier": "_skill/fleet-skills/fames/scripts/fames_fleet.py",
    "carrier_repo": "https://github.com/scss1199/ai_fleet_skills.git",
    "host_receipt": "contributors/<host>/manifest.json#skills[name=fames].package_sha",
    "unknown_rule": "A missing receipt, stale carrier manifest, unreadable bundle, or package hash mismatch is UNKNOWN and fails closed."
  }
