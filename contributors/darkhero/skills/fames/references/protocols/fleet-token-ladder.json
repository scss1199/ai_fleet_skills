  "north_star": "閉環疊代收斂：EXEC⇄…⇄GUARD 像 SCF；用 CG/BiCGStab/GMRES 選子空間加速 ‖R‖↓",
  "policy": {
    "single_entry": "FAMES 是五階段入口；本檔與 aex-agent-evolution 僅處理 AEX 跨週期進化階段",
    "alias_never_delete": true,
    "instruments_not_os": "MTM/MTO/PFKT/EFF/SEAT-SPEC are instruments only",
    "cycle_mandatory": "phases form a closed loop — never one-shot; next cycle starts at EXEC after GUARD",
    "bump_on_concept_change": "PATCH=prose; MINOR=rung/engine; MAJOR=equation rewrite"
  },
  "flywheel": {
    "phases": ["execution", "distillation", "augmented_execution"],
    "cite": "SEA-Eval Evolutionary Flywheel",
    "closed_cycle": ["EXEC", "INSTR", "DISTILL", "PROMOTE", "OPEN", "GUARD", "EXEC"]
  },
  "scf_bridge": {
    "protocol": "_registry/scf-protocol.json",
    "pfkt_protocol": "_registry/pfkt-protocol.json",
    "note": "PFKT = upper-level Fragment/Parallel overlay ON SCF (g,r,R,κ); AEX cycle drives field update ψ",
    "phase_to_scf_step": {
      "EXEC": ["ztm_execute", "result_verify"],
      "INSTR": ["pkt_ledger", "pfkt_bind"],
      "DISTILL": ["field_update"],
      "PROMOTE": ["field_update"],
      "OPEN": ["pfkt_split", "pfkt_wave", "pfkt_close"],
      "GUARD": ["residual", "goal_mint"]
    },
    "residual": {
      "R_aex": "0.5*(1-SR) + 0.3*min(1,T_norm) + 0.2*(1-A_norm)",
      "kappa": "R_n / R_{n-1} (from _registry/aex-iterate-state.json)",
      "sigma": "cos(gap_n, gap_{n-1}) via scf_numerics.compute_sigma",
      "anderson": "scf_numerics.anderson_extrapolate on R history",
      "periodic_pulay": "scf_numerics.periodic_pulay_mix (every k=3 Anderson else linear)",
      "R_ops": "0.35*tray + 0.25*hubclock + 0.40*cursor (measure_r_ops); R_work=0.7*R_aex+0.3*R_ops",
      "aware": "_registry/aware-protocol.json · aware-field.py (ψ_hub / ψ_seat)",
      "converged_when": {"R_aex_lt": 0.15, "kappa_lt": 0.85, "stable_cycles": 2}
    }
  },
  "krylov": {
    "cite": "goal-compact-distillation.md · hub-portal Krylov solver selection · GPAW CG→BiCG→GMRES",
    "analogy": {
      "EXEC": "apply operator A (run with current ψ)",
      "INSTR": "form residual R = g - proj(r) / AEX gaps",
      "DISTILL": "build Krylov basis vector from R (compress trajectory)",
      "PROMOTE": "accept search direction into ψ (durable update)",
      "OPEN": "expand / restart subspace (archive variants = stepping stones)",
      "GUARD": "convergence test + precondition / held-out verify"
    },
    "solvers": [
      {
        "id": "CG",
        "when": "kappa < 0.7 AND sigma >= 0.8 AND R_aex decreasing",
        "phases": ["EXEC", "INSTR", "DISTILL", "PROMOTE", "GUARD"],
        "skip": ["OPEN"],
        "note": "smooth SPD-like residual — cheapest cycle; skip OPEN archive"
      },
      {
        "id": "BiCGStab",
        "when": "sigma < 0.5 OR kappa oscillates (0.7..1.2)",
        "phases": ["EXEC", "INSTR", "DISTILL", "OPEN", "PROMOTE", "GUARD"],
        "skip": [],
        "note": "nonsymmetric / oscillating — bi-orthogonal: INSTR+OPEN search both ways"
      },
      {
        "id": "GMRES",
        "when": "kappa >= 1.0 OR R_aex not falling over 2 cycles OR verdict=pseudo",
        "phases": ["EXEC", "INSTR", "DISTILL", "PROMOTE", "OPEN", "GUARD"],
        "skip": [],
        "restart_m": 6,
        "anderson": true,
        "note": "stiff — full subspace + Anderson accelerate R; force OPEN archive"
      }
    ],
    "default_solver": "CG",
    "escalate": ["CG", "BiCGStab", "GMRES"]
  },
  "equations": {
    "primitives": {
      "SR": "verify-done rate (zat-verify-gate / claim-linter pass ratio on recent claims)",
      "T": "billable ktok (pptt ledger / EFF denominator)",
      "A": "durable asset delta (ADUS promote, new engine, SUBMIT, park pointer)",
      "N": "sequence index for similar tasks (same seat + goal stamp or thread)"
    },
    "slopes": {
      "K_eff": "(T_{k+1} - T_k) / ΔN",
      "K_SR": "(SR_{k+1} - SR_k) / ΔN",
      "K_A": "(A_{k+1} - A_k) / ΔN"
    },
    "genuine": "K_eff < 0 AND K_SR >= 0 AND K_A > 0",
    "pseudo": "SR acceptable AND K_eff ≈ 0 AND K_A <= 0",
    "AEX_scalar": "AEX = SR * (1 + α*A_norm) / (1 + β*T_norm) * (1 + γ*max(0, -K_eff)) * Γ",
    "weights": {"alpha": 0.5, "beta": 1.0, "gamma": 0.3},
    "Gamma": "alignment ∈ (0,1]: lower mandatory re-inject / extreme-stuck → higher Γ"
  },
  "instruments": {
    "note": "Measuring standards — not the evolution OS",
    "EFF": {
      "formula": "EFF = P / (K_billable_ktok × T_active_min)",
      "legacy": "PPTT",
      "ledger": "_logs/pptt/<project>.jsonl"
    },
    "PFKT": {
      "formula": "PF = 0.6*F + 0.4*P_par",
      "protocol": "_registry/pfkt-protocol.json",
      "role": "SCF upper overlay — Fragment/Parallel numerators; OPEN phase / GMRES subspace",
      "scf_parent": "_registry/scf-protocol.json"
    },
    "SCF": {
      "protocol": "_registry/scf-protocol.json",
      "role": "Self-Consistent Field iteration: g,r,R,κ,σ — AEX cycle updates ψ",
      "engines": ["scf-residual.py", "scf_numerics.py", "pfkt-scf-bridge.py"]
    },
    "MTM": {
      "classes": ["TR0", "TR1", "TW1", "TWD", "TRN"],
      "protocol": "_registry/mtm-protocol.json",
      "role": "constrain how T is sampled; not an evolution score alone"
    },
    "SEAT_SPEC": {
      "role": "seat O/V/C/I/E contract anchors",
      "legacy": "PPTT-SPEC"
    }
  },
