    "R_CONTRACT": "the package's own integrity: parity, surface identity, generation stamp",
    "R_SEMANTICS": "the validators still enforce the rules they claim to enforce",
    "R_FLEET": "convergence across hosts: receipts, published reports",
    "R_CAPABILITY": "declared but unimplemented capability",
    "R_HYGIENE": "residue at rest that should not exist",
    "R_FRESHNESS": "evidence age against a machine-enforced ceiling"
  },
  "kinds": {
    "path_exists": "path (workspace-relative), expect present|absent",
